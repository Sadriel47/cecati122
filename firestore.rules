rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    // Reglas para Cursos con validación de esquema y rol de administrador
    match /courses/{courseId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && 
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 3 &&
        request.resource.data.title.size() <= 150;
      allow delete: if isAuthenticated();
    }

    // Reglas para Solicitudes de Pre-registro (preRegistrations / registrations)
    // Lectura pública bloqueada: Solo administradores autenticados pueden listar/leer.
    // Creación pública permitida bajo validación estricta de esquema.
    match /preRegistrations/{regId} {
      allow read: if isAuthenticated();
      allow create: if request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 3 &&
        request.resource.data.fullName.size() <= 80 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.matches('^[0-9]{10}$');
      allow update, delete: if isAuthenticated();
    }

    match /registrations/{regId} {
      allow read: if isAuthenticated();
      allow create: if request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 3 &&
        request.resource.data.fullName.size() <= 80 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.matches('^[0-9]{10}$');
      allow update, delete: if isAuthenticated();
    }

    // Reglas para Usuarios
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated();
    }

    // Reglas para Noticias / Avisos
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Reglas para Testimonios
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }
  }
}
