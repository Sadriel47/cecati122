rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Reglas para imágenes de cursos en /courses/{imageId}
    match /courses/{imageId} {
      allow read: if true;
      allow write, delete: if isAuthenticated() && isValidImage();
    }

    // Reglas para imágenes de noticias / blog en /posts/{imageId}
    match /posts/{imageId} {
      allow read: if true;
      allow write, delete: if isAuthenticated() && isValidImage();
    }

    // Reglas para fotos / avatares de testimonios en /testimonials/{imageId}
    match /testimonials/{imageId} {
      allow read: if true;
      allow write, delete: if isAuthenticated() && isValidImage();
    }
  }
}
